---
// The only <html> and <head> of the site: pages pass their title, description and
// JSON-LD and never write their own <title>.
import { Font } from "astro:assets";
import ConsentBanner from "../components/ConsentBanner.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { site } from "../config/site";
// Bumped by every PR that changes the built site; read on the live page to confirm a deploy.
import { version } from "../../package.json";
import "../styles/global.css";

interface Props {
  // Without the site name; the home page passes its full title.
  title: string;
  description: string;
  // schema.org objects for this page only.
  jsonLd?: Record<string, unknown>[];
  // Notes: og:type article and their dates.
  article?: { publishedAt: Date; updatedAt?: Date };
  // Keeps the page out of search results and the sitemap (astro.config.mjs).
  noindex?: boolean;
}

const {
  title,
  description,
  jsonLd = [],
  article,
  noindex = false,
} = Astro.props;
// One URL form: no trailing slash (home aside), no `.html`, no `/index`.
const path = Astro.url.pathname.replace(/(\/index)?(\.html)?\/?$/, "") || "/";
const canonical = new URL(path, site.url).href;
const fullTitle = path === "/" ? title : `${title} · ${site.name}`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <Font cssVariable="--font-sans" preload />
    <Font cssVariable="--font-mono" preload />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="version" content={version} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${site.name} · Notes`}
      href="/rss.xml"
    />
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:image" content={new URL("/og.png", site.url).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content={`${site.name}: ${site.description}`}
    />
    {article && (
      <>
        <meta
          property="article:published_time"
          content={article.publishedAt.toISOString()}
        />
        {article.updatedAt && (
          <meta
            property="article:modified_time"
            content={article.updatedAt.toISOString()}
          />
        )}
      </>
    )}
    {/* X reads title, description and URL from the OG tags above. */}
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd.map((data) => (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(data).replace(/</g, "\\u003c")}
      />
    ))}
  </head>
  <body>
    <a class="skip-link q-btn q-btn--primary" href="#main">
      Skip to content
    </a>
    <div class="q">
      <SiteHeader />
      <main id="main">
        <slot />
      </main>
      <SiteFooter />
    </div>
    <ConsentBanner />
  </body>
</html>
